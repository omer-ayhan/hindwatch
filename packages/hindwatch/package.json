{
  "name": "hindwatch",
  "version": "0.0.0-development",
  "description": "One timeline of Android, iOS simulator and React Native logs for coding agents, over a CLI and MCP.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/omer-ayhan/hindwatch.git", "directory": "packages/hindwatch" },
