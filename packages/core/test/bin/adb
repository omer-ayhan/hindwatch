#!/bin/sh
# Stands in for adb with one device running an app that has gone quiet: pid 4242, one logcat entry,
# then nothing, and no ANRs in the system buffer. Appends each `shell pidof` to $FAKE_ADB_CALLS.
# Stays a shell while it streams so it shows up as `adb ... logcat` in ps, and takes its sleep with
# it when the supervisor stops it.
[ "$1" = -s ] && shift 2
# $1 as $2 bytes, little-endian.
le() { v=$1; i=0; while [ "$i" -lt "$2" ]; do printf "\\$(printf %o $((v & 255)))"; v=$((v >> 8)); i=$((i + 1)); done; }
# One liblog entry as `logcat -B` frames it: pid $1, tag $2, message $3, at info, stamped now.
entry() { le $((${#2} + ${#3} + 3)) 2; le 20 2; le "$1" 4; le "$1" 4; le "$(date +%s)" 4; le 0 4; printf '\4%s\0%s\0' "$2" "$3"; }
quiet() { trap 'kill $s 2>/dev/null; exit 0' TERM; while :; do sleep 3600 & s=$!; wait $s; done; }
case "$1 $2" in
  "devices "*) printf 'List of devices attached\nPERF-SERIAL\tdevice\n' ;;
  "get-serialno "*) echo PERF-SERIAL ;;
  "shell pidof") echo "pidof $(date +%s)" >> "$FAKE_ADB_CALLS"; echo 4242 ;;
  "shell date") echo "$(date +%s)" ;;
  "shell cat") echo perf-boot ;;
  "exec-out logcat")
    case " $* " in
      *" -d "*) ;;
      *" --pid=4242 "*) entry 4242 PerfApp attached; quiet ;;
      *) quiet ;;
    esac ;;
  *) exit 1 ;;
esac
